# Obligatorias en producción (Vercel > Settings > Environment Variables)
PAYLOAD_SECRET=            # cadena larga y aleatoria (openssl rand -hex 32)
NEXT_PUBLIC_SERVER_URL=    # dirección pública de esta app, ej. https://articulos.thehumantechnologies.com
NEXT_PUBLIC_MAIN_SITE_URL= # dirección de la landing, ej. https://xd.com.gt

# Las pone Vercel solas al conectar los almacenes (Storage)
DATABASE_URL=              # Neon Postgres (Marketplace)
BLOB_READ_WRITE_TOKEN=     # Vercel Blob

# Opcional: otros sitios autorizados a leer la API, separados por coma
EXTRA_ORIGINS=
